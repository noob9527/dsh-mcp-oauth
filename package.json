{
  "name": "@noob9527/dsh-mcp-oauth",
  "version": "0.2.0",
  "description": "OAuth MCP tools for unmodified DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-alpha.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "pnpm run typecheck && pnpm run build",
    "acceptance": "node scripts/acceptance.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:compatibility": "node scripts/compatibility.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-remote-access": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-authorization": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.3"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.3",
    "@modelcontextprotocol/server": "2.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-authorization": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.3"
  },
  "packageManager": "pnpm@12.5.1",
  "keywords": [
    "deepseek-harness",
    "mcp",
    "oauth",
    "pkce",
    "cimd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noob9527/dsh-mcp-oauth.git"
  },
  "homepage": "https://github.com/noob9527/dsh-mcp-oauth#readme",
  "bugs": {
    "url": "https://github.com/noob9527/dsh-mcp-oauth/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
